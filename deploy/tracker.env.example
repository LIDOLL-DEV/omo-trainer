NODE_ENV=production
HOST=10.1.1.23
PORT=4173
BASE_PATH=/tracker/
PUBLIC_ORIGIN=https://lidoll.dev
OIDC_ISSUER=https://auth.sadgirlsclub.wtf
OIDC_CLIENT_ID=little-log
# Back-channel wallet verification; OIDC_ISSUER remains the public identity URL.
LIDOLLCOIN_IDENTITY_URL=http://10.1.1.23:4180/wallet/identity
DATA_DIR=/var/lib/lidoll/tracker

# Server-only mint/refund authority. Provision using scripts/configure-reward-authority.mjs.
# LIDOLLCOIN_REWARD_KEYS='{"lidollbot":"<random base64url key shared only with the bot server>"}'
# Separate LiDollQuest service; this gateway retains browser wallet cookie/CSRF checks.
# LIDOLLQUEST_API_URL=http://127.0.0.1:4191/

# Optional Web Push. Generate once: npx web-push generate-vapid-keys
# Keep the private key stable and secret; use your real contact URL or mailto address.
# PUSH_VAPID_SUBJECT=https://lidoll.dev
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=

# Optional server-to-server Littlepottchi bridge, avoiding public hairpin NAT.
# LITTLEPOTTCHI_API_URL=http://10.1.1.23:4190/littlepottchi/integration/v1/
# LITTLEPOTTCHI_BRIDGE_TOKEN=<same dedicated random secret as MommyBot>
